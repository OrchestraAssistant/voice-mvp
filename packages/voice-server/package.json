{
  "name": "@yourco/voice-server",
  "version": "0.1.2",
  "description": "Server-half handlers for @yourco/voice providers: the OpenAI Realtime relay and the JEV cascade broker, as mountable Web (Request)=>Response handlers.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrchestraAssistant/voice-mvp.git",
    "directory": "packages/voice-server"
  },
  "type": "module",
  "exports": {
    "./openai": "./dist/openai.js",
    "./jev": "./dist/jev.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/openai.js src/jev.js --bundle --platform=node --format=esm --outdir=dist --packages=external",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
